# Blog CMS (admin UI path is in src/lib/adminPaths.ts — do not put it in public docs)
BLOG_ADMIN_PASSWORD=
BLOG_ADMIN_SECRET=
# Digital Products admin (falls back to BLOG_ADMIN_PASSWORD if unset)
# DIGITAL_PRODUCTS_ADMIN_PASSWORD=
# DIGITAL_PRODUCTS_ADMIN_SECRET=
# Password reminder emails go here (default: yomiodeneye@hotmail.com)
# SITE_ADMIN_REMINDER_EMAIL=
# CONTACT_NOTIFY_EMAIL=yomiodeneye@hotmail.com
# Live mother mailer (password reminder + contact fallback)
# MOTHER_EMAIL_API=https://hometolive.com/api/front/send-email.jsp
# MOTHER_EMAIL_SECRET=
# ADMIN_NOTIFY_EMAIL=bay192@gmail.com

# Production publish: commit src/data/blog-posts.json so Vercel rebuilds
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# Contact form mail (cPanel SMTP on Vercel — not Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional — defaults in api/contact.ts
# FROM_EMAIL=You Or Me Innovations <no-reply@youormeinnovations.com>
# CONTACT_NOTIFY_EMAIL=yomiodeneye@hotmail.com

# Stripe (digital product downloads). Live and test are different keys.
# Thank-you pages from Stripe test mode need sk_test_ or downloads stay locked.
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_TEST=
# YOUORME_STRIPE_SECRET_KEY=
# YOUORME_STRIPE_SECRET_KEY_TEST=
# YOUORME_STRIPE_TEST_MODE=1
